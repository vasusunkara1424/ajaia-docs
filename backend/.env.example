# Copy to backend/.env for local overrides. All values are optional locally.

# SQLite by default; use a Postgres URL in production (e.g. Neon).
DATABASE_URL=sqlite:///./ajaia_docs.db

# Required in production: a long random string.
SECRET_KEY=change-me-to-a-long-random-string

# "development" enables CORS for the Vite dev server.
ENVIRONMENT=development
